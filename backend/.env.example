# ThreatDNA-AI Environment Configuration

# Database Configuration (MySQL 8+ or SQLite fallback)
# MySQL Example: mysql+pymysql://root:yourpassword@localhost:3306/threatdna_ai
# SQLite Example: sqlite:///./threatdna_ai.db
DATABASE_URL=sqlite:///./threatdna_ai.db

# JWT Security
JWT_SECRET_KEY=threatdna_ai_super_secret_cyber_security_jwt_key_2026_soc_platform
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers Configuration
# Provider options: "gemini", "openai", "heuristic"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (Provide when connecting real cloud LLMs; otherwise heuristic engine is used)
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS & Server
FRONTEND_URL=http://localhost:5173
UPLOADS_DIR=../uploads
